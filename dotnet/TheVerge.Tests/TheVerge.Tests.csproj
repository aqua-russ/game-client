<Project Sdk="Microsoft.NET.Sdk">
  <!-- Тесты Core, Network и Data без Unity: dotnet test dotnet/TheVerge.sln -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>TheVerge.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- NUnit: тот же стиль тестов, что у Unity Test Framework. Решение пользователя от 2026-11-11. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>

  <!-- Матрица пакетов — источник ожиданий для PacketTableTests (ADR 0010 п. 7): тест читает её из папки тестов. -->
  <ItemGroup>
    <None Include="../../docs/protocol/packets.csv" Link="Network/Framing/packets.csv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../TheVerge.Core.csproj" />
    <ProjectReference Include="../TheVerge.Network.csproj" />
    <ProjectReference Include="../TheVerge.Data.csproj" />
    <!-- Бот — консольная программа; тесты проверяют его цикл, коды выхода и параметры без запуска процесса. -->
    <ProjectReference Include="../TheVerge.Bot/TheVerge.Bot.csproj" />
  </ItemGroup>
</Project>
